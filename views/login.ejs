<%- include('partials/header') %>
<section class="auth-page shell"><form class="auth-card" action="/login" method="post"><span class="eyebrow">Только для сотрудников</span><h1>Вход в рабочее пространство</h1><p>Покупателям регистрация не требуется.</p><label>Логин<input name="login" autocomplete="username" required autofocus></label><label>Пароль<input type="password" name="password" autocomplete="current-password" required></label><% if (error) { %><div class="form-error"><%= error %></div><% } %><button class="button button-primary" type="submit">Войти</button></form></section>
<%- include('partials/footer') %>
