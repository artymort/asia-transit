<%- include('../partials/header') %>
<section class="staff-page shell" data-car-editor data-car-id="<%= car.id %>" data-csrf="<%= csrfToken %>">
  <div class="editor-header"><div><a href="/staff">← Все автомобили</a><h1><%= car.title || 'Новый автомобиль' %></h1><p class="save-state" id="save-state">Сохранено</p></div><div class="editor-header-actions"><form action="/staff/cars/<%= car.id %>/status" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if (car.status === 'draft') { %><button class="button button-primary" name="action" value="publish">Опубликовать</button><% } else if (car.status === 'published') { %><button class="button button-outline" name="action" value="archive">В архив</button><% } else { %><button class="button button-primary" name="action" value="restore">Вернуть в продажу</button><% } %></form></div></div>
  <% if (String(locals.queryError || '') || false) { %><div class="form-error"><%= locals.queryError %></div><% } %>
  <% if (typeof requestQuery !== 'undefined' && requestQuery.error) { %><div class="form-error"><%= requestQuery.error %></div><% } %>
  <div class="editor-layout">
    <form class="editor-form" id="car-editor-form">
      <section class="editor-section"><h2>Основная информация</h2><div class="form-grid"><label class="wide">Название объявления<input name="title" value="<%= car.title %>" placeholder="Например, Toyota Camry 2021"></label><label>Марка<input name="brand" value="<%= car.brand %>"></label><label>Модель<input name="model" value="<%= car.model %>"></label><label>Год<input name="year" type="number" min="1900" max="2100" value="<%= car.year || '' %>"></label><label>Пробег, км<input name="mileage" type="number" min="0" value="<%= car.mileage ?? '' %>"></label><label>Цена, ₽<input name="price" type="number" min="0" value="<%= car.price ?? '' %>"></label><label>Кузов<input name="bodyType" value="<%= car.body_type %>"></label><label class="checkbox-label"><input name="pricePublic" type="checkbox" <%= car.price_public ? 'checked' : '' %>>Показывать цену покупателю</label><label class="wide">Описание<textarea name="description" rows="8"><%= car.description %></textarea></label></div></section>
      <section class="editor-section"><div class="editor-section-heading"><div><h2>Характеристики</h2><p>Внутренние значения никогда не передаются гостю.</p></div></div><div class="characteristics-list"><% characteristics.forEach(item => { %><div class="characteristic-row" data-characteristic data-id="<%= item.id %>"><label><%= item.name %><% if (item.is_required) { %><b>обязательно</b><% } %><input data-characteristic-value value="<%= item.value %>"></label><label class="checkbox-label"><input data-characteristic-public type="checkbox" <%= item.is_public ? 'checked' : '' %>>Показывать покупателю</label></div><% }) %></div></section>
    </form>
    <aside class="editor-aside"><div class="analytics-card"><span>Просмотры</span><strong><%= viewStats.total || 0 %></strong><dl><div><dt>Сегодня</dt><dd><%= viewStats.today || 0 %></dd></div><div><dt>За 7 дней</dt><dd><%= viewStats.week || 0 %></dd></div></dl></div><div class="editor-tip"><h2>Фотографии</h2><p>Загрузка, сортировка и выбор главной фотографии будут подключены следующим модулем. Схема хранения уже создана.</p></div><% if (currentUser.role === 'admin') { %><form class="danger-zone" action="/staff/cars/<%= car.id %>/delete" method="post" data-confirm-delete><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>Удаление</h2><p>Удаляет запись и все файлы без восстановления.</p><button class="button button-danger" type="submit">Удалить навсегда</button></form><% } %></aside>
  </div>
</section>
<script src="/static/staff-editor.js" defer></script>
<%- include('../partials/footer') %>
